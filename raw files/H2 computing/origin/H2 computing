ents */\nlabel, input, select {\n    display: block;\n    width: 100%;\n    margin-bottom: 15px;\n    box-sizing: border-box;\n}\n\ninput[type\u003d\"submit\"] {\n    background-color: #2F8A7B;\n    color: white;\n    padding: 10px;\n    border: none;\n    cursor: pointer;\n}\n\ninput[type\u003d\"submit\"]:hover {\n    background-color: #1f5f54; /* Light state change feedback on hover */\n}\n\n.error-msg {\n    color: red;\n    font-weight: bold;\n}\n```",
