      "text": "This reference package collates and optimizes all the web development, relational database (SQLite), and non-relational database (MongoDB) patterns you have mastered. These boilerplates are structured specifically for the H2 Computing (9569) practical exam environment (Python 3.7) [1].\n\n---\n\n## Module 1: The Relational SQLite Pipeline\nThis boilerplate handles table resetting, dynamic database seeding from a CSV, dictionary-like row access, and secure parameterised joins.\n\n```python\nimport sqlite3\nimport csv\n\n# 1. Database Connection \u0026 Dictionary Mapping Configuration\nconn \u003d sqlite3.connect(\"database.db\")\nconn.row_factory \u003d sqlite3.Row  # Enables column access by header string (e.g., row[\u0027name\u0027])\ncur \u003d conn.cursor()\n\n# 2. Re-runnable Table Initialization (Saves time during exam debugging)\ncur.execute(\"DROP TABLE IF EXISTS student\")\ncur.execute(\"DROP TABLE IF EXISTS late\")\n\n# 3. Dynamic Schema Generation and CSV Import (Using zip())\nwith open(\u0027STUDENT.csv\u0027, \u0027r\u0027) as file:\n    reader \u003d csv.reader(file)\n    headers \u003d next(reader)  # Dynamic retrieval of column names\n    \n    cur.execute(f\"\"\"\n        CREATE TABLE IF NOT EXISTS student (\n            {headers[0]} INTEGER PRIMARY KEY,\n            {headers[1]} TEXT,\n            {headers[2]} TEXT,\n            {headers[3]} INTEGER\n        )\n    \"\"\")\n    \n    for row in reader:\n        cur.execute(f\"\"\"\n            INSERT OR IGNORE INTO student ({headers[0]}, {headers[1]}, {headers[2]}, {headers[3]})\n            VALUES (?, ?, ?, ?)\n        \"\"\", row)\n\nwith open(\u0027LATE.csv\u0027) as file:\n    reader \u003d csv.reader(file)\n    headers_late \u003d next(reader)\n    cur.execute(f\"\"\"\n        CREATE TABLE IF NOT EXISTS late (\n            {headers_late[0]} TEXT,\n            {headers_late[1]} INTEGER,\n            {headers_url[2]} TEXT,\n            FOREIGN KEY({headers_1[1]}) REFERENCES student({headers[0]})\n        )\n    \"\"\")\n    for row in reader:\n        cur.execute(f\"\"\"\n            INSERT INTO latecoming ({headers_late[0]}, {headers_late[1]}) \n            VALUES (?, ?)\n        \"\"\", row)\n\nconn.commit()  # Commits write operations (inserts/creates)\n\n# 4. Secure Relational Parameterised INNER JOIN Query\nquery_class \u003d \"25S02X\"\ncur.execute(\"\"\"\n    SELECT student.name, student.civics_class, late.date, late.reason \n    FROM student \n    INNER JOIN late ON student.stu_id \u003d late.stu_id \n    WHERE student.civics_class \u003d ?\n    ORDER BY late.date DESC\n\"\"\", (query_class,))\n\nresults \u003d cur.fetchall()  # List of sqlite3.Row objects\n\nfor row in results:\n    # Safe to read via header string due to row_factory setting\n    print(f\"Student: {row[\u0027name\u0027]}, Class: {row[\u0027civics_class\u0027]}, Late: {row[\u0027date\u0027]}\")\n\nconn.close()\n```\n\n---\n\n## Module 2: The Document MongoDB Pipeline\nThis boilerplate establishes connections, clears stale collections, dynamically maps flat CSV data to NoSQL documents, and joins related datasets using an aggregation pipeline.\n\n```python\nimport pymongo\nimport csv\n\n# 1. Establish Client and Database Instances\nclient \u003d pymongo.MongoClient(\"mongodb://localhost:27017/\")\ndb \u003d client[\u0027college_db\u0027]\nstudb \u003d db[\u0027student\u0027]\nlatedb \u003d db[\u0027late\u0027]\n\n# 2. Reset Collections (Saves time during exam debugging)\nstudb.delete_many({})\nlatedb.delete_many({})\n\n# 3. Dynamic Document Seeding using zip()\nwith open(\u0027STUDENT.csv\u0027, \u0027r\u0027) as file:\n    reader \u003d csv.reader(file)\n    headers \u003d next(reader)\n    for row in reader:\n        # Dynamically matches headers to fields\n        record \u003d dict(zip(headers, row))\n        studb.insert_one(record)\n\nwith open(\u0027LATE.csv\u0027, \u0027r\u0027) as file:\n    reader \u003d csv.reader(file)\n    headers_late \u003d next(reader)\n    for row in reader:\n        record \u003d dict(zip(headers_late, row))\n        latedb.insert_one(record)\n\n# 4. Aggregation Pipeline ($lookup) to Join Collections on Keys\nquery_class \u003d \"25S02X\"\npipeline \u003d [\n    # Stage 1: Filter main collection records\n    {\"$match\": {\"civics_class\": query_class}},\n    \n    # Stage 2: Join related collection (inner loop)\n    {\"$lookup\": {\n        \"from\": \"late\",             # MUST be exact DB collection name (string)\n        \"localField\": \"stu_id\",      # Field in main collection (\u0027student\u0027)\n        \"foreignField\": \"stu_id\",    # Field in related collection (\u0027late\u0027)\n        \"as\": \"attendance_records\"  # Output field array name\n    }},\n    \n    # Stage 3: Match only if the joined array is not empty\n    {\"$match\": {\"attendance_records\": {\"$ne\": []}}}\n]\n\nresults \u003d list(studb.aggregate(pipeline))\n\nfor doc in results:\n    # Use .get() to prevent KeyErrors on optional elements\n    name \u003d doc.get(\u0027name\u0027, \u0027N/A\u0027)\n    late_list \u003d doc.get(\u0027attendance_records\u0027, [])\n    print(f\"Student: {name} has {len(late_list)} late records.\")\n\nclient.close()\n```\n\n---\n\n## Module 3: The Full-Stack Flask Web Server\nThis boilerplate implements HTTP method handling, safe parameter collection retrieval, dynamic/variable routing logic, and standard server-side rendering.\n\n```python\nfrom flask import Flask, render_template, request, redirect, url_for\nimport sqlite3\n\napp \u003d Flask(__name__)\naccepted_methods \u003d [\u0027GET\u0027, \u0027POST\u0027]\n\n# A. Basic GET/POST Route with Defensive Data Validation\n@app.route(\u0027/\u0027, methods\u003daccepted_methods)\ndef home():\n    if request.method \u003d\u003d \u0027POST\u0027:\n        # Retrieve form data defensively using .get() to avoid KeyErrors\n        category \u003d request.form.get(\u0027category\u0027, \u0027\u0027).strip()\n        name \u003d request.form.get(\u0027name\u0027, \u0027\u0027).strip()\n        \n        if not name or not category:\n            return render_template(\"home.html\", error\u003d\"Please fill in all fields.\")\n            \n        # Post-Redirect-Get pattern prevents double submission when page is refreshed\n        return redirect(url_for(\u0027search_results\u0027, category\u003dcategory, name\u003dname))\n        \n    return render_template(\"home.html\", error\u003dNone)\n\n# B. Variable Routing and Integration Route\n@app.route(\u0027/results/\u003ccategory\u003e/\u003cname\u003e\u0027)\ndef search_results(category, name):\n    conn \u003d sqlite3.connect(\"database.db\")\n    conn.row_factory \u003d sqlite3.Row\n    cur \u003d conn.cursor()\n    \n    # Executing our Relational Join\n    cur.execute(\"\"\"\n        SELECT student.name, student.civics_class, late.date, late.reason \n        FROM student \n        INNER JOIN late ON student.stu_id \u003d late.stu_id \n        WHERE student.name LIKE ? AND late.reason \u003d ?\n    \"\"\", (f\"%{name}%\", category))\n    \n    data \u003d cur.fetchall()\n    conn.close()\n    \n    # Passing data structure straight to template for loop rendering\n    return render_template(\"results.html\", results\u003ddata, category\u003dcategory, name\u003dname)\n\nif __name__ \u003d\u003d \u0027__main__\u0027:\n    # Use standard testing port (5000/8000) with debug mode enabled during mock tests\n    app.run(port\u003d5000, debug\u003dTrue)\n```\n\n---\n\n## Module 4: Standard HTML5 and CSS Template\nThis UI layout utilizes semantic structuring, centers the form inside a container, implements a distinct header table, and includes basic conditional formatting logic.\n\n### `home.html` (The Input Interface)\n```html\n\u003c!doctype html\u003e\n\u003chtml\u003e\n\u003chead\u003e\n    \u003ctitle\u003eLatecoming Search\u003c/title\u003e\n    \u003c!-- Use standard Flask url_for directory helper --\u003e\n    \u003clink rel\u003d\"stylesheet\" href\u003d\"{{ url_for(\u0027static\u0027, filename\u003d\u0027style.css\u0027) }}\"\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n    \u003cdiv class\u003d\"container\"\u003e\n        \u003ch1\u003eLatecoming Search\u003c/h1\u003e\n        \n        {% if error %}\n        \u003cp class\u003d\"error-msg\"\u003e{{ error }}\u003c/p\u003e\n        {% endif %}\n        \n        \u003cform method\u003d\"POST\" action\u003d\"/\"\u003e\n            \u003clabel\u003eReason for Latecoming:\u003c/label\u003e\n            \u003cselect name\u003d\"category\"\u003e\n                \u003coption value\u003d\"Medical\"\u003eMedical\u003c/option\u003e\n                \u003coption value\u003d\"Family\"\u003eFamily\u003c/option\u003e\n                \u003coption value\u003d\"Other\"\u003eOther\u003c/option\u003e\n            \u003c/select\u003e\n            \n            \u003clabel\u003eStudent Name:\u003c/label\u003e\n            \u003cinput type\u003d\"text\" name\u003d\"name\"\u003e\n            \n            \u003cinput type\u003d\"submit\" value\u003d\"Submit Query\"\u003e\n        \u003c/form\u003e\n    \u003c/div\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n```\n\n### `results.html` (Dynamic Table Rendering with Logic)\n```html\n\u003c!doctype html\u003e\n\u003chtml\u003e\n\u003chead\u003e\n    \u003ctitle\u003eResults\u003c/title\u003e\n    \u003clink rel\u003d\"stylesheet\" href\u003d\"{{ url_for(\u0027static\u0027, filename\u003d\u0027style.css\u0027) }}\"\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n    \u003cdiv class\u003d\"container\"\u003e\n        \u003ch1\u003eSearch Results\u003c/h1\u003e\n        \u003cp\u003eResults for student matching: \u003cstrong\u003e{{ name }}\u003c/strong\u003e inside category: \u003cstrong\u003e{{ category }}\u003c/strong\u003e\u003c/p\u003e\n        \n        {% if results %}\n        \u003ctable\u003e\n            \u003cthead\u003e\n                \u003ctr\u003e\n                    \u003cth\u003eStudent Name\u003c/th\u003e\n         